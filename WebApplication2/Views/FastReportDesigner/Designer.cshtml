@model FastReport.Web.WebReport
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FastReport Designer</title>
    <style>
        html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
        .toolbar {
            padding: 8px 12px;
            background: #1e3a5f;
            color: #fff;
            font-family: Segoe UI, sans-serif;
            font-size: 14px;
        }
        .designer-wrap { height: calc(100vh - 40px); }
    </style>
</head>
<body>
    <div class="toolbar">
        FastReport layout editor — save from the designer toolbar when finished.
        (Report @ViewBag.TransactionReportID, Company @ViewBag.CompanyID)
    </div>
    <div class="designer-wrap">
        @await Model.Render()
    </div>
</body>
</html>
